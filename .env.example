# Copy this file to `.env` at the repository root and fill in real values.
# The names below are exactly what backend/config.py reads — renaming any of
# them will either break startup or silently fall back to a default.
#
# Precedence: real environment variables win over this file. A value already
# exported in your shell (or supplied by Kubernetes/ECS/Heroku/docker-compose)
# is NOT replaced by the value here. To flip that for local development — so
# .env beats a stale variable stuck in your shell — export DOTENV_OVERRIDE=true
# in the shell. Setting DOTENV_OVERRIDE inside .env itself has no effect: the
# flag is read before this file is loaded, precisely so a deployed .env cannot
# grant itself priority over platform configuration.

# Database — local mongodb://... or an Atlas mongodb+srv://... URI
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_simulator

# Auth — AUTH_JWT_SECRET is required; the backend refuses to start without it.
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRY_HOURS=24

# Password policy. The maximum is a UTF-8 BYTE length, not a character count,
# because bcrypt refuses secrets over 72 bytes — a 30-character emoji password
# is already 120 bytes. Values above 72 are rejected at startup.
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_BYTES=72

# Abuse protection for /auth/*. Counters are per-process: with multiple workers
# the effective limit is multiplied by the worker count, and across instances
# they are not shared. For a horizontally scaled deployment, enforce limits at
# the proxy/gateway or back these with Redis.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per-account backoff after consecutive failed sign-ins.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_SECONDS=300

# Password reset. url_base is the frontend page that reads ?token=... from the
# emailed link and submits it to POST /auth/reset-password — set it to your
# real frontend domain in production, the same way CORS_ALLOWED_ORIGINS above
# needs to be.
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# Email delivery for the password-reset link. "console" (default) logs the
# email instead of sending it — real behavior for local dev, nothing to
# configure. Set EMAIL_PROVIDER=smtp and the SMTP_* values below to actually
# send mail through any relay (Gmail, SendGrid, Mailgun, SES, Postmark, ...).
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_USE_TLS=true

# Per-user hourly spend caps on the routes that cost real money. These bound
# cost rather than block attacks (the AUTH_* throttles above do that): every
# metered route calls a paid LLM API or consumes sandboxed compute, so an
# ordinary signed-in user can run up a bill without doing anything abusive.
# Exceeding a cap returns 429 with Retry-After. Same per-process caveat as the
# auth throttles — N workers means N times the allowance.
QUOTA_RESUME_PARSE_PER_HOUR=10
QUOTA_ROLE_MATCH_PER_HOUR=20
QUOTA_DSA_EXECUTION_PER_HOUR=60
QUOTA_VOICE_PER_HOUR=200
# Answer evaluations during a live interview round. These arrive as WebSocket
# messages rather than HTTP requests, so a client can send them in a tight loop;
# each one is a Groq call. Speech synthesis and transcription inside the socket
# draw on QUOTA_VOICE_PER_HOUR above, shared with the /voice/* REST routes.
QUOTA_INTERVIEW_TURN_PER_HOUR=120
QUOTA_WINDOW_SECONDS=3600

# Groq LLM — enables resume parsing, question generation, and answer evaluation
GROQ_API_KEY=
GROQ_RESUME_MODEL=openai/gpt-oss-120b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_FEEDBACK_MODEL=openai/gpt-oss-20b

# Judge0 — required only for the DSA coding round.
# Note the host port is 2359 when using docker-compose.judge0.yml (it maps
# 2359 on the host to 2358 in the container).
JUDGE0_API_BASE_URL=http://127.0.0.1:2359

# Judge0 authentication. docker-compose.judge0.yml now runs Judge0 with authn
# enabled, so set this to the same value as JUDGE0_AUTH_TOKEN there. Leave blank
# only if you are pointing at a Judge0 instance with authentication disabled.
# The header name must match AUTHN_HEADER in that compose file.
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=

# Consumed by docker-compose.judge0.yml itself (not by the backend). Generate
# each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JUDGE0_WORKER_TOKEN=
# JUDGE0_POSTGRES_PASSWORD=
# JUDGE0_REDIS_PASSWORD=

# Voice / TTS — piper is the default local provider; elevenlabs is optional
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Leave false unless you explicitly need the local-filesystem resume parse route
ENABLE_LOCAL_RESUME_PATH_API=false

# CORS — browser origins allowed to call this API. Defaults to the Vite dev
# server, which is why local development needs no configuration here. A real
# deployment MUST set this to its actual frontend domain(s), comma-separated
# (e.g. https://app.example.com,https://www.example.com) — without it, the
# production frontend cannot call this API at all.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Regex fallback, only ever matches http://localhost:<port> / 127.0.0.1:<port>.
# Harmless to leave at its default in production — no real browser sends that
# Origin for a deployed page. Override only if you need a different dev-port range.
# CORS_ALLOW_ORIGIN_REGEX=http://(127\.0\.0\.1|localhost):(517[0-9]|3000)

# Logging and error tracking
APP_ENV=development
LOG_LEVEL=INFO
# Set to a real Sentry DSN to enable error tracking; left blank, it's a no-op
# and sentry-sdk is never initialized.
# SENTRY_DSN=
# Fraction of requests to trace (0.0-1.0). Leave at 0 unless you want APM data.
# SENTRY_TRACES_SAMPLE_RATE=0

# Server / reverse proxy
# ---------------------------------------------------------------------------
# Rate limiting keys on the DIRECT peer address. backend/api/routes_auth.py
# deliberately refuses to trust X-Forwarded-For, because an attacker could
# otherwise mint a fresh budget per request by inventing a new value.
#
# The consequence is that behind a reverse proxy, request.client is the PROXY,
# so every user collapses into a single bucket: the whole deployment shares one
# 10-attempts-per-minute auth budget and one user tripping it locks out
# everybody.
#
# uvicorn is started with --proxy-headers, which rewrites request.client from
# the forwarded headers, but ONLY for peers listed here — so the header is
# still not blindly trusted. The default is localhost only, meaning nothing
# changes for a direct or docker-compose run.
#
# A proxied deployment must widen this to the proxy's address. Where the
# container is reachable only through the platform's own ingress (Hugging Face
# Spaces, Cloud Run), "*" is the practical value:
#     UVICORN_FORWARDED_ALLOW_IPS=*
# Never set "*" where the container port is reachable directly, or the header
# becomes forgeable again and the rate limit can be bypassed per request.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# Each worker keeps its own in-process rate-limit and quota counters, so N
# workers multiply every configured limit by N. See README section 7.7.
UVICORN_WORKERS=1

# Semantic role matching
# ---------------------------------------------------------------------------
# Role matching scores resumes against role profiles using a sentence-transformers
# encoder (all-MiniLM-L6-v2). When that model cannot be loaded, matching falls
# back to token overlap. The fallback is deliberate — it keeps local development
# and CI working with no model download — but it produces materially worse
# matches, and a deployment that silently switches to it looks completely
# healthy: the process starts and /health returns 200. Only the
# semantic_matching.active_backend field in /health reveals it.
#
# Set this in any real deployment. backend/Dockerfile already sets it, because
# the models are baked into the image there, so a load failure is a packaging
# error rather than an expected condition.
# REQUIRE_SEMANTIC_ENCODER=true
#
# The other half of the same switch: skip the encoder entirely. Useful for a
# fast local run or a constrained machine, at the cost of match quality.
# DISABLE_SEMANTIC_ENCODER=false

# Throttle storage
# ---------------------------------------------------------------------------
# Where rate limits and per-user spend quotas keep their counters.
#
#   memory (default) - per process. Correct for a single worker, and actively
#                      wrong for more than one: each worker keeps its own
#                      counters, so every configured limit is multiplied by the
#                      worker count. A restart also resets everything, which
#                      matters because the quotas exist to bound a bill.
#   mongo            - shared through MongoDB. Survives restarts, holds across
#                      workers and instances. Each check is a single atomic
#                      update, so concurrent requests cannot both slip under
#                      the limit.
#
# The default is memory so local development and the test suite need no
# database. backend/Dockerfile sets mongo. Any deployment running more than one
# worker should too -- the backend logs a warning at startup if it is not.
RATE_LIMIT_BACKEND=memory
