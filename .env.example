# Database configuration
# Use a local mongodb://... or an Atlas mongodb+srv://... URI
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=interview_simulator

# Security
JWT_SECRET=YOUR_SUPER_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Voice / TTS Settings
TTS_PROVIDER=edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
