# Environment secrets — never commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
# Suffixed environments too (.venv311, .venv-3.11). Without the glob, a
# virtualenv built under any other name is untracked but NOT ignored, so a
# `git add -A` would happily commit a multi-gigabyte torch install.
.venv*/
venv*/
*.egg-info/
dist/
build/

# VS Code
.vscode/

# Node / React
node_modules/
frontend/dist/
frontend/build/

# Misc
*.log
.DS_Store
Thumbs.db
# Added by code-review-graph
.code-review-graph/

# Judge0 local config — contains REDIS_PASSWORD / POSTGRES_PASSWORD that must be
# filled in per machine. The pristine upstream template is inside
# .local/judge0/judge0-v1.13.1.zip; extract it and set your own values.
.local/judge0/judge0-v1.13.1/judge0.conf

# Kilo Code IDE agent tooling — developer-local, not part of the application
.kilo/
